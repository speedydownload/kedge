# Normalize all text to LF in the repo (checkout as-is on every platform,
# so macOS and Linux get clean LF working trees; the repo was authored on
# Windows and renormalized when this file was added).
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
*.keystore binary
*.jks binary
